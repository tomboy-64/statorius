# Maintainer: Your Name <your.email@example.com>
_pkgname=statorius
pkgname=${_pkgname}-git
pkgver=0.7.9
pkgrel=1
pkgdesc="A networking toolkit (development build)"
arch=('x86_64')
url="https://github.com/tomboy-64/statorius"
license=('AGPL3')

depends=('glibc' 'gcc-libs')
makedepends=('rust' 'cargo' 'git' 'git-lfs')
provides=("${_pkgname}")
conflicts=("${_pkgname}")

source=("${_pkgname}::git+https://github.com/tomboy-64/${_pkgname}.git"
        "${_pkgname}.desktop")

sha256sums=('SKIP'
            'SKIP')

export RUSTUP_TOOLCHAIN=stable

pkgver() {
    cd "$srcdir/$_pkgname"
    # Uses git tags if present (e.g., 0.6.1.r2.g1a2b3c4), otherwise falls back to revision count
    git describe --long --tags 2>/dev/null | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//' || \
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/$_pkgname"

    # ico/*.png (including ico/statorius-master.png, which build.rs now
    # reads to generate the app icon on every build - see build.rs) are
    # git-lfs tracked. makepkg's VCS git+ source only does a plain clone,
    # which - unlike a manually-configured local checkout - can't be
    # relied on to have the LFS smudge filter already registered, so it
    # would otherwise leave these as pointer text instead of real PNGs.
    # `--local` scopes the filter registration to just this repo copy.
    git lfs install --local

    # makepkg clones this working copy from its own local mirror cache
    # (a file:// path next to this PKGBUILD, kept around so repeat builds
    # don't re-clone from GitHub every time) rather than from GitHub
    # directly - so `origin` right now points at that local mirror. LFS
    # object *content* only ever lives on GitHub's LFS storage, never in
    # that mirror (a plain git clone only ever copies the pointer text,
    # the same reason build.rs needs lfs:true in CI - see release.yml),
    # so `git lfs pull` needs `origin` pointed at the real repo first or
    # it fails trying to fetch objects from a local path that never had
    # them. Keep this URL in sync with the one in source= above.
    git remote set-url origin "https://github.com/tomboy-64/${_pkgname}.git"
    git lfs pull
}

build() {
    cd "$srcdir/$_pkgname"

    cargo build --release --locked
}

package() {
    cd "$srcdir/$_pkgname"

    # 1. Install compiled binary
    install -Dm755 "target/release/$_pkgname" "$pkgdir/usr/bin/$_pkgname"

    # 2. Install desktop launcher
    install -Dm644 "$srcdir/$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"

    # 3. Install the hicolor-theme icon set (statorius.desktop's Icon=statorius
    #    resolves against these) at every size shipped under ico/hicolor/.
    for size_dir in "$srcdir/$_pkgname/ico/hicolor"/*/apps; do
        size=$(basename "$(dirname "$size_dir")")
        install -Dm644 "$size_dir/$_pkgname.png" \
            "$pkgdir/usr/share/icons/hicolor/$size/apps/$_pkgname.png"
    done
}
